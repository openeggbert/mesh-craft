<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           version="0.3">

  <!-- ============================================================
       MC3 Scene Format — XML Schema
       Version: 0.3
       ============================================================ -->

  <!-- ── Primitive types ──────────────────────────────────────── -->

  <xs:simpleType name="floatTokenType">
    <xs:restriction base="xs:string">
      <xs:pattern value="\s*-?[0-9]*\.?[0-9]+([eE][+-]?[0-9]+)?\s*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Space-separated float tuples — allow any whitespace between tokens -->
  <xs:simpleType name="vec2Type">
    <xs:restriction base="xs:string">
      <xs:pattern value="\s*-?[0-9]*\.?[0-9]+([eE][+-]?[0-9]+)?\s+-?[0-9]*\.?[0-9]+([eE][+-]?[0-9]+)?\s*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="vec3Type">
    <xs:restriction base="xs:string">
      <xs:pattern value="\s*-?[0-9]*\.?[0-9]+([eE][+-]?[0-9]+)?(\s+-?[0-9]*\.?[0-9]+([eE][+-]?[0-9]+)?){2}\s*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="vec4Type">
    <xs:restriction base="xs:string">
      <xs:pattern value="\s*-?[0-9]*\.?[0-9]+([eE][+-]?[0-9]+)?(\s+-?[0-9]*\.?[0-9]+([eE][+-]?[0-9]+)?){3}\s*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- vec3 OR vec4 — for base_color which accepts RGB or RGBA -->
  <xs:simpleType name="colorType">
    <xs:restriction base="xs:string">
      <xs:pattern value="\s*-?[0-9]*\.?[0-9]+([eE][+-]?[0-9]+)?(\s+-?[0-9]*\.?[0-9]+([eE][+-]?[0-9]+)?){2,3}\s*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="axisType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="x"/>
      <xs:enumeration value="y"/>
      <xs:enumeration value="z"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="wrapModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="repeat"/>
      <xs:enumeration value="clamp"/>
      <xs:enumeration value="mirror"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="filterType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="linear"/>
      <xs:enumeration value="nearest"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="colorSpaceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="srgb"/>
      <xs:enumeration value="linear"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="alphaModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="opaque"/>
      <xs:enumeration value="mask"/>
      <xs:enumeration value="blend"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="fogModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="linear"/>
      <xs:enumeration value="exponential"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="cameraProjectionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="perspective"/>
      <xs:enumeration value="orthographic"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="roleType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="cutter"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="coordinateSystemType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="right_handed_y_up"/>
      <xs:enumeration value="right_handed_z_up"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="unitType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="meter"/>
      <xs:enumeration value="centimeter"/>
      <xs:enumeration value="inch"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- rotation_units: degrees (default) or radians -->
  <xs:simpleType name="rotationUnitsType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="degrees"/>
      <xs:enumeration value="radians"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- euler_order: which axis is applied first/last when composing rotations -->
  <xs:simpleType name="eulerOrderType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="XYZ"/>
      <xs:enumeration value="XZY"/>
      <xs:enumeration value="YXZ"/>
      <xs:enumeration value="YZX"/>
      <xs:enumeration value="ZXY"/>
      <xs:enumeration value="ZYX"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ── UV Mapping ───────────────────────────────────────────── -->

  <xs:complexType name="uvMappingType">
    <!-- Actually written/read by Mc3XmlWriter/Mc3XmlParser as separate
         per-axis attributes, not the combined vec2 "scale"/"offset" below
         (which are declared for forward-compatibility but currently
         unused by either the writer or the parser). -->
    <xs:attribute name="projection" type="xs:string"/>  <!-- "planar" | "box" | "sphere" -->
    <xs:attribute name="scale_u"    type="xs:float"/>
    <xs:attribute name="scale_v"    type="xs:float"/>
    <xs:attribute name="offset_u"   type="xs:float"/>
    <xs:attribute name="offset_v"   type="xs:float"/>
    <xs:attribute name="rotation"   type="xs:float"/>
    <xs:attribute name="scale"      type="vec2Type"/>
    <xs:attribute name="offset"     type="vec2Type"/>
  </xs:complexType>

  <!-- ── Meta (new-style key-value) ──────────────────────────── -->

  <xs:complexType name="metaentryType">
    <xs:attribute name="key"   type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="metaType">
    <xs:sequence>
      <xs:element name="metaentry" type="metaentryType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Metadata (legacy) ─────────────────────────────────────── -->
  <!--
    Key/value store for opaque pass-through data (e.g. source-format metadata
    captured during import that has no first-class MC3 representation).
  -->
  <xs:complexType name="metadataType">
    <xs:sequence>
      <xs:element name="property" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="name"  type="xs:string" use="required"/>
          <xs:attribute name="value" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Per-object named states (Mc3Object::states) ─────────────
       Distinct from the document-level <states><state name="..."> (N6,
       sceneStateType) — this is a per-object <state id="..."> child that
       Mc3XmlWriter emits for every object type unconditionally, mirroring
       Mc3ObjectState's fields exactly. -->

  <xs:complexType name="objectStateType">
    <xs:attribute name="id"       type="xs:string"  use="required"/>
    <xs:attribute name="position" type="vec3Type"/>
    <xs:attribute name="rotation" type="vec3Type"/>
    <xs:attribute name="scale"    type="vec3Type"/>
    <xs:attribute name="visible"  type="xs:boolean"/>
    <xs:attribute name="material" type="xs:string"/>
  </xs:complexType>

  <!-- ── Shared object attributes ─────────────────────────────── -->
  <!--
    Transform order: T(position+pivot) * R(rotation) * S(scale) * T(-pivot)
    rotation values are interpreted according to the root rotation_units and
    euler_order attributes.
  -->
  <xs:attributeGroup name="objectAttrs">
    <xs:attribute name="id"        type="xs:string"/>
    <xs:attribute name="name"      type="xs:string"/>
    <xs:attribute name="position"  type="vec3Type"/>
    <xs:attribute name="rotation"  type="vec3Type"/>
    <xs:attribute name="scale"     type="vec3Type"/>
    <xs:attribute name="pivot"     type="vec3Type"/>
    <xs:attribute name="material"  type="xs:IDREF"/>   <!-- references material/@id -->
    <xs:attribute name="visible"   type="xs:boolean"  default="true"/>
    <xs:attribute name="collision" type="xs:string"   default="none"/>
    <xs:attribute name="tags"      type="xs:string"/>
    <xs:attribute name="layer"     type="xs:string"/>
    <xs:attribute name="role"      type="roleType"/>
    <xs:attribute name="script"    type="xs:IDREF"/>   <!-- R103: references script/@id -->
  </xs:attributeGroup>

  <!-- ── Deform element ───────────────────────────────────────── -->

  <xs:complexType name="deformType">
    <xs:attribute name="scale" type="vec3Type" use="required"/>
  </xs:complexType>

  <!-- ── R111 asset metadata (mesh_world_revival.md §6) ──────────
       Present only on definitions where authored/known; see
       Mc3AssetMetadata.hpp for the authorable-fields-only rationale. -->

  <xs:complexType name="assetTagListType">
    <xs:sequence>
      <xs:element name="tag" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="value" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="assetSocketsType">
    <xs:sequence>
      <xs:element name="socket" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="name"     type="xs:string" use="required"/>
          <xs:attribute name="position" type="vec3Type"  use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="assetLodsType">
    <xs:sequence>
      <xs:element name="lod" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <!-- "definition" is a plain string, not xs:IDREF: the referenced
               id may live in an imported library, not this document. -->
          <xs:attribute name="tier"       type="xs:string" use="required"/>
          <xs:attribute name="definition" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="assetMetadataType">
    <xs:sequence>
      <xs:element name="semanticTags"  type="assetTagListType" minOccurs="0"/>
      <xs:element name="styleTags"     type="assetTagListType" minOccurs="0"/>
      <xs:element name="regionTags"    type="assetTagListType" minOccurs="0"/>
      <xs:element name="periodTags"    type="assetTagListType" minOccurs="0"/>
      <xs:element name="materialSlots" type="assetTagListType" minOccurs="0"/>
      <xs:element name="sockets"       type="assetSocketsType" minOccurs="0"/>
      <xs:element name="lods"          type="assetLodsType"    minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="category"                type="xs:string"/>
    <xs:attribute name="subcategory"             type="xs:string"/>
    <xs:attribute name="facing"                  type="xs:string"/>
    <xs:attribute name="collision_proxy"         type="xs:string"/>
    <xs:attribute name="shadow_policy"           type="xs:string"/>
    <xs:attribute name="license"                 type="xs:string"/>
    <xs:attribute name="provenance"              type="xs:string"/>
    <xs:attribute name="source"                  type="xs:string"/>
    <xs:attribute name="version"                 type="xs:string"/>
    <xs:attribute name="instancing_eligible"     type="xs:boolean" default="true"/>
    <xs:attribute name="max_visibility_distance" type="xs:float"/>
    <xs:attribute name="selection_weight"        type="xs:float" default="1"/>
    <xs:attribute name="nominal_size"            type="vec3Type"/>
    <xs:attribute name="bounds_min"              type="vec3Type"/>
    <xs:attribute name="bounds_max"              type="vec3Type"/>
    <xs:attribute name="clearance_volume"        type="vec3Type"/>
  </xs:complexType>

  <!-- ── R110/R101 library identity + imports (root-level, .mc3lib.xml
       and any document that imports one) ────────────────────────── -->

  <xs:complexType name="libraryType">
    <xs:attribute name="namespace" type="xs:string" use="required"/>
    <xs:attribute name="version"   type="xs:string" use="required"/>
    <xs:attribute name="hash"      type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="importType">
    <xs:attribute name="namespace" type="xs:string" use="required"/>
    <xs:attribute name="source"    type="xs:string" use="required"/>
    <xs:attribute name="hash"      type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="importsType">
    <xs:sequence>
      <xs:element name="import" type="importType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Extrude sub-elements ─────────────────────────────────── -->

  <xs:complexType name="pointType">
    <xs:attribute name="x" type="xs:float" use="required"/>
    <xs:attribute name="y" type="xs:float" use="required"/>
    <xs:attribute name="z" type="xs:float"/>
    <!-- bezier path control-point handle (Mc3XmlWriter.cpp writes these for
         ExtrudePathType::Bezier points) -->
    <xs:attribute name="cx" type="xs:float"/>
    <xs:attribute name="cy" type="xs:float"/>
    <xs:attribute name="cz" type="xs:float"/>
  </xs:complexType>

  <xs:complexType name="crossSectionType">
    <xs:sequence>
      <xs:element name="point" type="pointType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="type" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="rect"/>
          <xs:enumeration value="circle"/>
          <xs:enumeration value="polygon"/>
          <xs:enumeration value="custom"/>
          <xs:enumeration value="star"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <!-- rect -->
    <xs:attribute name="width"        type="xs:float"/>
    <xs:attribute name="height"       type="xs:float"/>
    <!-- circle / polygon -->
    <xs:attribute name="radius"       type="xs:float"/>
    <xs:attribute name="segments"     type="xs:positiveInteger"/>
    <!-- hollow tube -->
    <xs:attribute name="inner_radius" type="xs:float"/>
    <!-- polygon / star -->
    <xs:attribute name="sides"        type="xs:positiveInteger"/>
  </xs:complexType>

  <xs:complexType name="pathType">
    <xs:sequence>
      <xs:element name="point" type="pointType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="type" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="line"/>
          <xs:enumeration value="arc"/>
          <xs:enumeration value="helix"/>
          <xs:enumeration value="polyline"/>
          <xs:enumeration value="bezier"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <!-- line -->
    <xs:attribute name="axis"   type="axisType"/>
    <xs:attribute name="length" type="xs:float"/>
    <!-- arc -->
    <xs:attribute name="radius" type="xs:float"/>
    <xs:attribute name="angle"  type="xs:float"/>
    <!-- helix -->
    <!-- radius (shared), height, turns -->
    <xs:attribute name="height" type="xs:float"/>
    <xs:attribute name="turns"  type="xs:float"/>
  </xs:complexType>

  <!-- ── Object types ─────────────────────────────────────────── -->

  <!-- box -->
  <xs:complexType name="boxType">
    <xs:sequence>
      <xs:element name="deform"     type="deformType"    minOccurs="0"/>
      <xs:element name="uv_mapping" type="uvMappingType" minOccurs="0"/>
      <xs:element name="metadata"   type="metadataType"  minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"      type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
    <xs:attribute name="size"     type="vec3Type"/>
    <xs:attribute name="segments" type="xs:positiveInteger"/>
  </xs:complexType>

  <!-- sphere -->
  <xs:complexType name="sphereType">
    <xs:sequence>
      <xs:element name="deform"     type="deformType"    minOccurs="0"/>
      <xs:element name="uv_mapping" type="uvMappingType" minOccurs="0"/>
      <xs:element name="metadata"   type="metadataType"  minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"      type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
    <xs:attribute name="radius"   type="xs:float"/>
    <xs:attribute name="segments" type="xs:positiveInteger"/>
  </xs:complexType>

  <!-- cylinder -->
  <xs:complexType name="cylinderType">
    <xs:sequence>
      <xs:element name="deform"     type="deformType"    minOccurs="0"/>
      <xs:element name="uv_mapping" type="uvMappingType" minOccurs="0"/>
      <xs:element name="metadata"   type="metadataType"  minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"      type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
    <xs:attribute name="radius"   type="xs:float"/>
    <xs:attribute name="height"   type="xs:float"/>
    <xs:attribute name="segments" type="xs:positiveInteger"/>
    <xs:attribute name="axis"     type="axisType"/>
  </xs:complexType>

  <!-- cone -->
  <xs:complexType name="coneType">
    <xs:sequence>
      <xs:element name="deform"     type="deformType"    minOccurs="0"/>
      <xs:element name="uv_mapping" type="uvMappingType" minOccurs="0"/>
      <xs:element name="metadata"   type="metadataType"  minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"      type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
    <xs:attribute name="radius"   type="xs:float"/>
    <xs:attribute name="height"   type="xs:float"/>
    <xs:attribute name="segments" type="xs:positiveInteger"/>
  </xs:complexType>

  <!-- plane -->
  <xs:complexType name="planeType">
    <xs:sequence>
      <xs:element name="deform"     type="deformType"    minOccurs="0"/>
      <xs:element name="uv_mapping" type="uvMappingType" minOccurs="0"/>
      <xs:element name="metadata"   type="metadataType"  minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"      type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
    <xs:attribute name="size"     type="vec2Type"/>
    <xs:attribute name="axis"     type="axisType"/>
    <xs:attribute name="segments" type="xs:positiveInteger"/>
  </xs:complexType>

  <!-- cube (unit box, same attributes as box) -->
  <xs:complexType name="cubeType">
    <xs:sequence>
      <xs:element name="deform"     type="deformType"    minOccurs="0"/>
      <xs:element name="uv_mapping" type="uvMappingType" minOccurs="0"/>
      <xs:element name="metadata"   type="metadataType"  minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"      type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
    <xs:attribute name="size"     type="vec3Type"/>
    <xs:attribute name="segments" type="xs:positiveInteger"/>
  </xs:complexType>

  <!-- torus -->
  <xs:complexType name="torusType">
    <xs:sequence>
      <xs:element name="deform"     type="deformType"    minOccurs="0"/>
      <xs:element name="uv_mapping" type="uvMappingType" minOccurs="0"/>
      <xs:element name="metadata"   type="metadataType"  minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"      type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
    <xs:attribute name="major_radius" type="xs:float"/>
    <xs:attribute name="minor_radius" type="xs:float"/>
    <xs:attribute name="segments"     type="xs:positiveInteger"/>
  </xs:complexType>

  <!-- capsule -->
  <xs:complexType name="capsuleType">
    <xs:sequence>
      <xs:element name="deform"     type="deformType"    minOccurs="0"/>
      <xs:element name="uv_mapping" type="uvMappingType" minOccurs="0"/>
      <xs:element name="metadata"   type="metadataType"  minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"      type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
    <xs:attribute name="radius"   type="xs:float"/>
    <xs:attribute name="height"   type="xs:float"/>
    <xs:attribute name="segments" type="xs:positiveInteger"/>
    <xs:attribute name="axis"     type="axisType"/>
  </xs:complexType>

  <!-- disk -->
  <xs:complexType name="diskType">
    <xs:sequence>
      <xs:element name="deform"     type="deformType"    minOccurs="0"/>
      <xs:element name="uv_mapping" type="uvMappingType" minOccurs="0"/>
      <xs:element name="metadata"   type="metadataType"  minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"      type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
    <xs:attribute name="radius"       type="xs:float"/>
    <xs:attribute name="inner_radius" type="xs:float"/>
    <xs:attribute name="segments"     type="xs:positiveInteger"/>
    <xs:attribute name="axis"         type="axisType"/>
  </xs:complexType>

  <!-- grid -->
  <xs:complexType name="gridType">
    <xs:sequence>
      <xs:element name="deform"     type="deformType"    minOccurs="0"/>
      <xs:element name="uv_mapping" type="uvMappingType" minOccurs="0"/>
      <xs:element name="metadata"   type="metadataType"  minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"      type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
    <xs:attribute name="size"           type="vec3Type"/>
    <xs:attribute name="subdivisions_x" type="xs:positiveInteger"/>
    <xs:attribute name="subdivisions_z" type="xs:positiveInteger"/>
  </xs:complexType>

  <!-- icosphere -->
  <xs:complexType name="icosphereType">
    <xs:sequence>
      <xs:element name="deform"     type="deformType"    minOccurs="0"/>
      <xs:element name="uv_mapping" type="uvMappingType" minOccurs="0"/>
      <xs:element name="metadata"   type="metadataType"  minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"      type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
    <xs:attribute name="radius"   type="xs:float"/>
    <xs:attribute name="segments" type="xs:positiveInteger"/>
  </xs:complexType>

  <!-- mesh -->
  <xs:complexType name="meshType">
    <xs:sequence>
      <xs:element name="deform"     type="deformType"    minOccurs="0"/>
      <xs:element name="uv_mapping" type="uvMappingType" minOccurs="0"/>
      <xs:element name="metadata"   type="metadataType"  minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"      type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
    <xs:attribute name="src" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- extrude -->
  <xs:complexType name="extrudeType">
    <xs:sequence>
      <xs:element name="deform"        type="deformType"       minOccurs="0"/>
      <xs:element name="uv_mapping"    type="uvMappingType"    minOccurs="0"/>
      <xs:element name="cross_section" type="crossSectionType" minOccurs="1" maxOccurs="1"/>
      <xs:element name="path"          type="pathType"         minOccurs="1" maxOccurs="1"/>
      <xs:element name="metadata"      type="metadataType"     minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"         type="objectStateType"  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
    <xs:attribute name="segments" type="xs:positiveInteger"/>
    <xs:attribute name="twist"    type="xs:float"/>
    <xs:attribute name="smooth"   type="xs:boolean"/>
    <xs:attribute name="caps"     type="xs:boolean"/>
  </xs:complexType>

  <!-- instance -->
  <xs:complexType name="instanceType">
    <xs:sequence>
      <xs:element name="deform"   type="deformType"      minOccurs="0"/>
      <xs:element name="metadata" type="metadataType"    minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"    type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
    <xs:attribute name="definition"        type="xs:IDREF"  use="required"/>  <!-- references definition/@id -->
    <xs:attribute name="material_override" type="xs:IDREF"/>                 <!-- references material/@id -->
    <xs:attribute name="variants"          type="xs:string"/>                <!-- space-separated definition ids -->
  </xs:complexType>

  <!-- area -->
  <xs:complexType name="areaType">
    <xs:sequence>
      <xs:element name="deform"   type="deformType"      minOccurs="0"/>
      <xs:element name="metadata" type="metadataType"    minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"    type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
    <xs:attribute name="size" type="vec3Type"/>
  </xs:complexType>

  <!-- ── Recursive group / CSG ────────────────────────────────── -->

  <xs:complexType name="objectsContainerType">
    <xs:sequence>
      <xs:element name="deform"   type="deformType"      minOccurs="0"/>
      <xs:element name="metadata" type="metadataType"    minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"    type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:choice  minOccurs="0" maxOccurs="unbounded">
        <xs:element name="box"          type="boxType"/>
        <xs:element name="cube"         type="cubeType"/>
        <xs:element name="sphere"       type="sphereType"/>
        <xs:element name="cylinder"     type="cylinderType"/>
        <xs:element name="cone"         type="coneType"/>
        <xs:element name="plane"        type="planeType"/>
        <xs:element name="torus"        type="torusType"/>
        <xs:element name="capsule"      type="capsuleType"/>
        <xs:element name="disk"         type="diskType"/>
        <xs:element name="grid"         type="gridType"/>
        <xs:element name="icosphere"    type="icosphereType"/>
        <xs:element name="mesh"         type="meshType"/>
        <xs:element name="extrude"      type="extrudeType"/>
        <xs:element name="instance"     type="instanceType"/>
        <xs:element name="area"         type="areaType"/>
        <xs:element name="group"        type="objectsContainerType"/>
        <xs:element name="union"        type="csgContainerType"/>
        <xs:element name="difference"   type="csgContainerType"/>
        <xs:element name="intersection" type="csgContainerType"/>
      </xs:choice>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
  </xs:complexType>

  <!-- CSG roots are containers like groups, but own a generated-result UV
       mapping. This stays separate from objectsContainerType because that
       type is also used by top-level <objects> and ordinary <group>. -->
  <xs:complexType name="csgContainerType">
    <xs:sequence>
      <xs:element name="deform"     type="deformType"    minOccurs="0"/>
      <xs:element name="uv_mapping" type="uvMappingType" minOccurs="0"/>
      <xs:element name="metadata"   type="metadataType"  minOccurs="0"/>
      <xs:element name="assetMetadata" type="assetMetadataType" minOccurs="0"/>
      <xs:element name="state"      type="objectStateType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="box"          type="boxType"/>
        <xs:element name="cube"         type="cubeType"/>
        <xs:element name="sphere"       type="sphereType"/>
        <xs:element name="cylinder"     type="cylinderType"/>
        <xs:element name="cone"         type="coneType"/>
        <xs:element name="plane"        type="planeType"/>
        <xs:element name="torus"        type="torusType"/>
        <xs:element name="capsule"      type="capsuleType"/>
        <xs:element name="disk"         type="diskType"/>
        <xs:element name="grid"         type="gridType"/>
        <xs:element name="icosphere"    type="icosphereType"/>
        <xs:element name="mesh"         type="meshType"/>
        <xs:element name="extrude"      type="extrudeType"/>
        <xs:element name="instance"     type="instanceType"/>
        <xs:element name="area"         type="areaType"/>
        <xs:element name="group"        type="objectsContainerType"/>
        <xs:element name="union"        type="csgContainerType"/>
        <xs:element name="difference"   type="csgContainerType"/>
        <xs:element name="intersection" type="csgContainerType"/>
      </xs:choice>
    </xs:sequence>
    <xs:attributeGroup ref="objectAttrs"/>
  </xs:complexType>

  <!-- ── Environment ──────────────────────────────────────────── -->

  <xs:complexType name="backgroundType">
    <xs:attribute name="color"   type="vec3Type"/>
    <xs:attribute name="texture" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="fogType">
    <xs:attribute name="mode"    type="fogModeType" default="linear"/>
    <xs:attribute name="color"   type="vec3Type"/>
    <xs:attribute name="start"   type="xs:float"/>
    <xs:attribute name="end"     type="xs:float"/>
    <xs:attribute name="density" type="xs:float"/>
  </xs:complexType>

  <xs:complexType name="environmentType">
    <xs:sequence>
      <xs:element name="background"         type="backgroundType" minOccurs="0"/>
      <!-- Written as separate text-content sibling elements by Mc3XmlWriter,
           not via backgroundType's unused "texture" attribute below. -->
      <xs:element name="background_texture" type="xs:string"      minOccurs="0"/>
      <xs:element name="skybox_texture"     type="xs:string"      minOccurs="0"/>
      <xs:element name="fog"                type="fogType"        minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Lights ───────────────────────────────────────────────── -->

  <xs:complexType name="ambientLightType">
    <xs:attribute name="name"       type="xs:string"/>
    <xs:attribute name="color"      type="vec3Type"/>
    <xs:attribute name="brightness" type="xs:float"/>
  </xs:complexType>

  <xs:complexType name="directionalLightType">
    <xs:attribute name="name"         type="xs:string"/>
    <xs:attribute name="color"        type="vec3Type"/>
    <xs:attribute name="brightness"   type="xs:float"/>
    <xs:attribute name="direction"    type="vec3Type"/>
    <xs:attribute name="cast_shadows" type="xs:boolean"/>
  </xs:complexType>

  <xs:complexType name="pointLightType">
    <xs:attribute name="name"         type="xs:string"/>
    <xs:attribute name="color"        type="vec3Type"/>
    <xs:attribute name="brightness"   type="xs:float"/>
    <xs:attribute name="position"     type="vec3Type"/>
    <xs:attribute name="range"        type="xs:float"/>
    <xs:attribute name="cast_shadows" type="xs:boolean"/>
  </xs:complexType>

  <xs:complexType name="spotLightType">
    <xs:attribute name="name"         type="xs:string"/>
    <xs:attribute name="color"        type="vec3Type"/>
    <xs:attribute name="brightness"   type="xs:float"/>
    <xs:attribute name="position"     type="vec3Type"/>
    <xs:attribute name="direction"    type="vec3Type"/>
    <xs:attribute name="angle"        type="xs:float"/>
    <xs:attribute name="falloff"      type="xs:float"/>
    <xs:attribute name="range"        type="xs:float"/>
    <xs:attribute name="cast_shadows" type="xs:boolean"/>
  </xs:complexType>

  <xs:complexType name="lightsType">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="ambient"     type="ambientLightType"/>
        <xs:element name="directional" type="directionalLightType"/>
        <xs:element name="point"       type="pointLightType"/>
        <xs:element name="spot"        type="spotLightType"/>
      </xs:choice>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Cameras ──────────────────────────────────────────────── -->

  <xs:complexType name="cameraElementType">
    <xs:attribute name="name"     type="xs:string"/>
    <xs:attribute name="type"     type="cameraProjectionType" default="perspective"/>
    <xs:attribute name="position" type="vec3Type"/>
    <xs:attribute name="target"   type="vec3Type"/>
    <xs:attribute name="rotation" type="vec3Type"/>
    <xs:attribute name="near"     type="xs:float"/>
    <xs:attribute name="far"      type="xs:float"/>
    <!-- perspective -->
    <xs:attribute name="fov"      type="xs:float"/>
    <!-- orthographic -->
    <xs:attribute name="size"     type="xs:float"/>
    <!-- STAB-0695: orthographic view-volume width/height ratio (xmag =
         size * aspect, ymag = size). Optional, defaults to 1.0 (square). -->
    <xs:attribute name="aspect"   type="xs:float"/>
  </xs:complexType>

  <xs:complexType name="camerasType">
    <xs:sequence>
      <xs:element name="camera" type="cameraElementType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="default" type="xs:string"/>
  </xs:complexType>

  <!-- ── Textures ─────────────────────────────────────────────── -->

  <!-- mixed="true" allows inline SVG CDATA content -->
  <xs:complexType name="textureElementType" mixed="true">
    <xs:attribute name="id"          type="xs:ID"           use="required"/>
    <!-- Display name, independent of id (editor: "rename texture"); if
         omitted, readers should fall back to id. -->
    <xs:attribute name="name"        type="xs:string"/>
    <!-- type: "bitmap" (default) or "svg" -->
    <xs:attribute name="type"        type="xs:string"        default="bitmap"/>
    <!-- bitmap textures: uri points to image file -->
    <xs:attribute name="uri"         type="xs:anyURI"/>
    <!-- SVG textures: src points to .svg file; omit for inline CDATA content -->
    <xs:attribute name="src"         type="xs:anyURI"/>
    <xs:attribute name="wrap_u"      type="wrapModeType"     default="repeat"/>
    <xs:attribute name="wrap_v"      type="wrapModeType"     default="repeat"/>
    <xs:attribute name="filter"      type="filterType"       default="linear"/>
    <xs:attribute name="color_space" type="colorSpaceType"   default="srgb"/>
    <xs:attribute name="mip_maps"    type="xs:boolean"       default="true"/>
  </xs:complexType>

  <!-- ── Embeds ───────────────────────────────────────────────── -->

  <!-- mixed="true" allows inline base64 GLB content -->
  <xs:complexType name="embedElementType" mixed="true">
    <xs:attribute name="id"   type="xs:ID"     use="required"/>
    <!-- type: currently only "gltf" is defined -->
    <xs:attribute name="type" type="xs:string" use="required"/>
    <!-- src: path to external .glb file; omit for inline base64 content -->
    <xs:attribute name="src"  type="xs:anyURI"/>
  </xs:complexType>

  <xs:complexType name="embedsType">
    <xs:sequence>
      <xs:element name="embed" type="embedElementType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Scripts ──────────────────────────────────────────────── -->

  <!-- mixed="true" allows inline Lua source as text content (CDATA) -->
  <xs:complexType name="scriptElementType" mixed="true">
    <xs:attribute name="id"   type="xs:ID"     use="required"/>
    <!-- type: currently only "lua" is defined -->
    <xs:attribute name="type" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="scriptsType">
    <xs:sequence>
      <xs:element name="script" type="scriptElementType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Scene States ─────────────────────────────────────────── -->

  <xs:complexType name="objectOverrideType">
    <xs:attribute name="id"       type="xs:string"  use="required"/>
    <xs:attribute name="visible"  type="xs:boolean"/>
    <xs:attribute name="position" type="xs:string"/>
    <xs:attribute name="rotation" type="xs:string"/>
    <xs:attribute name="material" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="sceneStateType">
    <xs:sequence>
      <xs:element name="object-override" type="objectOverrideType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="statesType">
    <xs:sequence>
      <xs:element name="state" type="sceneStateType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Event bindings ───────────────────────────────────────── -->

  <xs:simpleType name="eventBindingEventType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="enter"/>
      <xs:enumeration value="exit"/>
      <xs:enumeration value="click"/>
      <xs:enumeration value="timer"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="eventBindingTargetType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="trigger"/>
      <xs:enumeration value="state"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="eventBindingType">
    <xs:attribute name="id"          type="xs:ID"                     use="required"/>
    <xs:attribute name="source"      type="xs:string"                 use="required"/>
    <xs:attribute name="event"       type="eventBindingEventType"     use="required"/>
    <xs:attribute name="target_type" type="eventBindingTargetType"    use="required"/>
    <xs:attribute name="target"      type="xs:string"                 use="required"/>
    <xs:attribute name="enabled"     type="xs:boolean"                default="true"/>
    <xs:attribute name="cooldown"    type="xs:float"                  default="0"/>
    <xs:attribute name="once"        type="xs:boolean"                default="false"/>
    <xs:attribute name="interval"    type="xs:float"                  default="1"/>
  </xs:complexType>

  <xs:complexType name="eventBindingsType">
    <xs:sequence>
      <xs:element name="binding" type="eventBindingType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Triggers ─────────────────────────────────────────────── -->

  <xs:complexType name="triggerStepRefType">
    <xs:attribute name="ref" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="triggerElementType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="play-action" type="triggerStepRefType"/>
      <xs:element name="play-sound"  type="triggerStepRefType"/>
      <xs:element name="run-script"  type="triggerStepRefType"/>
      <xs:element name="play-music"  type="triggerStepRefType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required"/>
  </xs:complexType>

  <xs:complexType name="triggersType">
    <xs:sequence>
      <xs:element name="trigger" type="triggerElementType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Sounds ───────────────────────────────────────────────── -->

  <xs:complexType name="soundElementType">
    <xs:attribute name="id"   type="xs:ID"      use="required"/>
    <xs:attribute name="src"  type="xs:anyURI"  use="required"/>
    <xs:attribute name="loop" type="xs:boolean" default="false"/>
  </xs:complexType>

  <xs:complexType name="soundsType">
    <xs:sequence>
      <xs:element name="sound" type="soundElementType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Music ────────────────────────────────────────────────── -->

  <xs:complexType name="musicTrackType">
    <xs:attribute name="id"   type="xs:ID"      use="required"/>
    <xs:attribute name="src"  type="xs:anyURI"  use="required"/>
    <xs:attribute name="loop" type="xs:boolean" default="true"/>
  </xs:complexType>

  <xs:complexType name="musicType">
    <xs:sequence>
      <xs:element name="track" type="musicTrackType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Textures ─────────────────────────────────────────────── -->

  <xs:complexType name="texturesType">
    <xs:sequence>
      <xs:element name="texture" type="textureElementType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Materials ────────────────────────────────────────────── -->

  <xs:complexType name="materialElementType">
    <xs:sequence>
      <!-- base_color accepts RGB (vec3) or RGBA (vec4); alpha defaults to 1.0 if omitted -->
      <xs:element name="base_color"                 minOccurs="0" type="colorType"/>
      <!-- emissive_color is always RGB (no alpha) -->
      <xs:element name="emissive_color"             minOccurs="0" type="vec3Type"/>
      <!-- texture slots reference texture/@id via IDREF -->
      <xs:element name="base_color_texture"         minOccurs="0" type="xs:IDREF"/>
      <xs:element name="metallic_roughness_texture" minOccurs="0" type="xs:IDREF"/>
      <xs:element name="normal_texture"             minOccurs="0" type="xs:IDREF"/>
      <xs:element name="occlusion_texture"          minOccurs="0" type="xs:IDREF"/>
      <xs:element name="emissive_texture"           minOccurs="0" type="xs:IDREF"/>
    </xs:sequence>
    <xs:attribute name="id"                 type="xs:ID"          use="required"/>
    <xs:attribute name="roughness"          type="xs:float"       default="0.5"/>
    <xs:attribute name="metallic"           type="xs:float"       default="0.0"/>
    <xs:attribute name="normal_scale"       type="xs:float"       default="1.0"/>
    <xs:attribute name="occlusion_strength" type="xs:float"       default="1.0"/>
    <xs:attribute name="alpha_mode"         type="alphaModeType"  default="opaque"/>
    <xs:attribute name="alpha_cutoff"       type="xs:float"       default="0.5"/>
    <xs:attribute name="double_sided"       type="xs:boolean"     default="false"/>
  </xs:complexType>

  <xs:complexType name="materialsType">
    <xs:sequence>
      <xs:element name="material" type="materialElementType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Definitions ──────────────────────────────────────────── -->

  <xs:complexType name="definitionType">
    <xs:sequence>
      <xs:choice minOccurs="1" maxOccurs="1">
        <xs:element name="box"          type="boxType"/>
        <xs:element name="cube"         type="cubeType"/>
        <xs:element name="sphere"       type="sphereType"/>
        <xs:element name="cylinder"     type="cylinderType"/>
        <xs:element name="cone"         type="coneType"/>
        <xs:element name="plane"        type="planeType"/>
        <xs:element name="torus"        type="torusType"/>
        <xs:element name="capsule"      type="capsuleType"/>
        <xs:element name="disk"         type="diskType"/>
        <xs:element name="grid"         type="gridType"/>
        <xs:element name="icosphere"    type="icosphereType"/>
        <xs:element name="mesh"         type="meshType"/>
        <xs:element name="extrude"      type="extrudeType"/>
        <xs:element name="group"        type="objectsContainerType"/>
        <xs:element name="union"        type="csgContainerType"/>
        <xs:element name="difference"   type="csgContainerType"/>
        <xs:element name="intersection" type="csgContainerType"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required"/>
  </xs:complexType>

  <xs:complexType name="definitionsType">
    <xs:sequence>
      <xs:element name="definition" type="definitionType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Animation types (v0.3) ──────────────────────────────── -->

  <xs:simpleType name="interpType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="step"/>
      <xs:enumeration value="linear"/>
      <xs:enumeration value="cubic"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="bezierHandleType">
    <xs:attribute name="dt" type="xs:float" default="0"/>
    <xs:attribute name="dv" type="xs:float" default="0"/>
  </xs:complexType>

  <xs:complexType name="mc3KeyframeType">
    <xs:sequence>
      <xs:element name="handle_left"  type="bezierHandleType" minOccurs="0"/>
      <xs:element name="handle_right" type="bezierHandleType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="time"   type="xs:float"   use="required"/>
    <xs:attribute name="value"  type="xs:float"   use="required"/>
    <xs:attribute name="interp" type="interpType" default="linear"/>
  </xs:complexType>

  <xs:complexType name="mc3ChannelType">
    <xs:sequence>
      <xs:element name="keyframe" type="mc3KeyframeType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="target"   type="xs:string" use="required"/>
    <xs:attribute name="property" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="mc3ActionType">
    <xs:sequence>
      <xs:element name="channel" type="mc3ChannelType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name"       type="xs:string"  use="required"/>
    <xs:attribute name="duration"   type="xs:float"   default="1.0"/>
    <xs:attribute name="loop"       type="xs:boolean" default="false"/>
    <xs:attribute name="autoplay"   type="xs:boolean" default="false"/>
    <!-- STAB-0460: playback-speed multiplier (2.0 = 2x speed). Optional,
         defaults to 1.0 (no-op). -->
    <xs:attribute name="time_scale" type="xs:float"   default="1.0"/>
  </xs:complexType>

  <xs:complexType name="mc3ActionsType">
    <xs:sequence>
      <xs:element name="action" type="mc3ActionType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Root element ─────────────────────────────────────────── -->

  <xs:element name="mc3">
    <xs:complexType>
      <xs:sequence>
        <!-- R110 library identity (.mc3lib.xml only) and R101 imports;
             written before includes by Mc3XmlWriter, so declared first here. -->
        <xs:element name="library" type="libraryType" minOccurs="0"/>
        <xs:element name="imports" type="importsType" minOccurs="0"/>
        <!-- Zero or more file includes (must appear before other sections) -->
        <xs:element name="include" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="file" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="metadata"    type="metadataType"         minOccurs="0"/>
        <xs:element name="meta"        type="metaType"             minOccurs="0"/>
        <xs:element name="environment" type="environmentType"      minOccurs="0"/>
        <xs:element name="lights"      type="lightsType"           minOccurs="0"/>
        <xs:element name="cameras"     type="camerasType"          minOccurs="0"/>
        <xs:element name="textures"    type="texturesType"         minOccurs="0"/>
        <xs:element name="materials"   type="materialsType"        minOccurs="0"/>
        <xs:element name="embeds"      type="embedsType"           minOccurs="0"/>
        <xs:element name="scripts"     type="scriptsType"          minOccurs="0"/>
        <xs:element name="sounds"      type="soundsType"           minOccurs="0"/>
        <xs:element name="music"       type="musicType"            minOccurs="0"/>
        <xs:element name="triggers"    type="triggersType"         minOccurs="0"/>
        <xs:element name="states"      type="statesType"           minOccurs="0"/>
        <xs:element name="event-bindings" type="eventBindingsType"  minOccurs="0"/>
        <xs:element name="definitions" type="definitionsType"      minOccurs="0"/>
        <xs:element name="objects"     type="objectsContainerType" minOccurs="0"/>
        <xs:element name="actions"     type="mc3ActionsType"       minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="version"           type="xs:string"            default="0.3"/>
      <xs:attribute name="model"             type="xs:string"/>
      <xs:attribute name="unit"              type="unitType"             default="meter"/>
      <xs:attribute name="coordinate_system" type="coordinateSystemType" default="right_handed_y_up"/>
      <!-- rotation_units and euler_order apply to ALL rotation attributes in the document -->
      <xs:attribute name="rotation_units"    type="rotationUnitsType"    default="degrees"/>
      <xs:attribute name="euler_order"       type="eulerOrderType"       default="XYZ"/>
      <xs:attribute name="default_camera"    type="xs:string"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
