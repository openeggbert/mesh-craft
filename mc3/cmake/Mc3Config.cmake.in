@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# A normal Mc3 build bundles the concrete tinyxml2 target into Mc3Targets.
# This fallback preserves compatibility with a parent project that supplies
# only an imported tinyxml2::tinyxml2 target.
if(NOT @MC3_BUNDLE_TINYXML2@)
    find_dependency(tinyxml2 CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/Mc3Targets.cmake")
check_required_components(Mc3)
