  <scripts>
    <script id="onOpen" type="lua">door:open()</script>
  </scripts>

  <sounds>
    <sound id="creak" src="sounds/creak.ogg"/>
  </sounds>

  <triggers>
    <trigger id="door_open">
      <play-action ref="anim_open"/>
