    <trigger id="pickup">
      <play-action ref="pickup_anim"/>
      <play-music  ref="fanfare"/>
    </trigger>
  </triggers>

  <objects>
    <box name="Door" size="1 2 0.1" position="0 1 0"/>
  </objects>

</mc3>
