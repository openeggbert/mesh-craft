<?xml version="1.0" encoding="UTF-8"?>
<!-- AUD-088 regression fixture. A single shadow-casting directional light
     plus one box, used with MESHCRAFT_TEST_FORCE_SHADOWDEBUG=1 to exercise
     initShadowDebug()/renderShadowDebugFbo() headlessly: the box must be
     visible somewhere in the light-view render, proving the migration from
     a raw-GL FBO+depth-texture pair to RenderTarget2D actually renders
     real scene content, not a blank/incomplete target. -->
<mc3 version="0.3" model="ShadowDebugFixture">

  <lights>
    <directional name="Sun" color="1.0 1.0 1.0" brightness="2.0" direction="0.3 -0.7 -0.5" cast_shadows="true"/>
  </lights>

  <cameras default="Cam">
    <camera name="Cam" position="0 0 6" target="0 0 0" fov="50"/>
  </cameras>

  <materials>
    <material id="white"><base_color>0.9 0.9 0.9 1.0</base_color></material>
  </materials>

  <objects>
    <box name="Target" size="2 2 2" position="0 0 0" material="white"/>
  </objects>

</mc3>
