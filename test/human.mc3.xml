             RIGHT LEG (mirror of left)
             ============================================================ -->
        <group name="RHipJoint" position="0.100 0 0">
          <sphere   name="RHipSph" radius="0.070" segments="12" position="0 0 0"          material="pants"/>
          <cylinder name="RThigh"  radius="0.066" height="0.370" segments="16" position="0 -0.185 0" material="pants"/>

          <group name="RKneeJoint" position="0 -0.370 0">
            <sphere   name="RKneeSph" radius="0.050" segments="12" position="0 0 0"           material="pants"/>
            <cylinder name="RCalf"    radius="0.050" height="0.378" segments="16" position="0 -0.189 0" material="pants"/>

            <group name="RAnkleJoint" position="0 -0.378 0">
