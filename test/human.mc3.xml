        <sphere name="Btn4" radius="0.010" segments="6" position="0 0.170 -0.158" material="button"/>
        <box name="CollarL" size="0.065 0.022 0.078" position="-0.038 0.582 -0.148" rotation="0 28 -7"  material="shirt"/>
        <box name="CollarR" size="0.065 0.022 0.078" position=" 0.038 0.582 -0.148" rotation="0 -28  7" material="shirt"/>

        <!-- ============================================================
             LEFT ARM
             shoulder world Y=1.415, X=-0.185
             upper arm 0.275 m  elbow world Y=1.140
             forearm   0.255 m  wrist world Y=0.885
             ============================================================ -->
        <group name="LShoulderJoint" position="-0.185 0.575 0">
          <sphere   name="LShoulderSph" radius="0.068" segments="12" position="0 0 0"          material="shirt"/>
          <cylinder name="LUpperArm"    radius="0.046" height="0.275" segments="16" position="0 -0.138 0" material="shirt"/>

          <group name="LElbowJoint" position="0 -0.275 0">
            <sphere   name="LElbowSph" radius="0.036" segments="10" position="0 0 0"          material="shirt"/>
            <cylinder name="LCuff"     radius="0.040" height="0.030" segments="16" position="0 -0.008 0" material="shirt"/>
