            <sphere name="LipCornerL" radius="0.010" segments="6"    position="-0.030 -0.062 -0.103"         material="lips"/>
            <sphere name="LipCornerR" radius="0.010" segments="6"    position=" 0.030 -0.062 -0.103"         material="lips"/>

          </group><!-- end HeadJoint -->
        </group><!-- end NeckJoint -->

      </group><!-- end Spine -->
    </group><!-- end Root -->

  </objects>

  <actions>

    <!-- ================================================================
         IDLE BREATH — 4 s loop, chest expands
         ================================================================ -->
    <action name="IdleBreath" duration="4.0" loop="true">
      <channel target="TorsoMesh" property="scale.x">
        <keyframe time="0.0" value="1.000" interp="cubic">
          <handle_right dt="0.6" dv="0.018"/>
        </keyframe>
        <keyframe time="2.0" value="1.030" interp="cubic">
          <handle_left  dt="-0.6" dv="0.018"/>
          <handle_right dt="0.6"  dv="-0.018"/>
        </keyframe>
        <keyframe time="4.0" value="1.000" interp="cubic">
          <handle_left  dt="-0.6" dv="-0.018"/>
        </keyframe>
      </channel>
      <channel target="TorsoMesh" property="scale.z">
        <keyframe time="0.0" value="1.000" interp="cubic">
          <handle_right dt="0.6" dv="0.012"/>
        </keyframe>
        <keyframe time="2.0" value="1.020" interp="cubic">
          <handle_left  dt="-0.6" dv="0.012"/>
          <handle_right dt="0.6"  dv="-0.012"/>
        </keyframe>
        <keyframe time="4.0" value="1.000" interp="cubic">
          <handle_left  dt="-0.6" dv="-0.012"/>
        </keyframe>
      </channel>
    </action>

    <!-- ================================================================
         HEAD SWAY — 7 s loop, subtle idle movement
         ================================================================ -->
    <action name="HeadSway" duration="7.0" loop="true">
      <channel target="HeadJoint" property="rotation.y">
        <keyframe time="0.0" value=" 0.0" interp="cubic">
          <handle_right dt="1.0" dv="-4.0"/>
        </keyframe>
        <keyframe time="2.0" value="-5.0" interp="cubic">
          <handle_left  dt="-1.0" dv="-4.0"/>
          <handle_right dt="1.0"  dv="4.0"/>
        </keyframe>
        <keyframe time="5.0" value=" 4.0" interp="cubic">
          <handle_left  dt="-1.0" dv="4.0"/>
          <handle_right dt="1.0"  dv="-3.0"/>
        </keyframe>
        <keyframe time="7.0" value=" 0.0" interp="cubic">
          <handle_left  dt="-1.0" dv="-3.0"/>
        </keyframe>
      </channel>
      <channel target="HeadJoint" property="rotation.z">
        <keyframe time="0.0" value=" 0.0" interp="cubic">
          <handle_right dt="1.2" dv="-1.5"/>
        </keyframe>
        <keyframe time="3.0" value="-2.5" interp="cubic">
          <handle_left  dt="-1.2" dv="-1.5"/>
          <handle_right dt="1.2"  dv="1.5"/>
        </keyframe>
        <keyframe time="7.0" value=" 0.0" interp="cubic">
          <handle_left  dt="-1.2" dv="1.5"/>
        </keyframe>
      </channel>
    </action>

    <!-- ================================================================
         BLINK — 5 s loop, double blink pattern
         ================================================================ -->
    <action name="Blink" duration="5.0" loop="true">
      <channel target="LEyelidTop" property="position.y">
        <keyframe time="0.00" value=" 0.010" interp="linear"/>
        <keyframe time="1.80" value=" 0.010" interp="linear"/>
        <keyframe time="1.87" value="-0.010" interp="linear"/>
        <keyframe time="1.94" value=" 0.010" interp="linear"/>
        <keyframe time="3.50" value=" 0.010" interp="linear"/>
        <keyframe time="3.57" value="-0.010" interp="linear"/>
        <keyframe time="3.64" value=" 0.010" interp="linear"/>
        <keyframe time="5.00" value=" 0.010" interp="linear"/>
      </channel>
      <channel target="REyelidTop" property="position.y">
        <keyframe time="0.00" value=" 0.010" interp="linear"/>
        <keyframe time="1.80" value=" 0.010" interp="linear"/>
        <keyframe time="1.87" value="-0.010" interp="linear"/>
        <keyframe time="1.94" value=" 0.010" interp="linear"/>
        <keyframe time="3.50" value=" 0.010" interp="linear"/>
        <keyframe time="3.57" value="-0.010" interp="linear"/>
        <keyframe time="3.64" value=" 0.010" interp="linear"/>
        <keyframe time="5.00" value=" 0.010" interp="linear"/>
      </channel>
    </action>

    <!-- ================================================================
         WALK — 1.4 s loop, full gait cycle
         t=0.00  right heel strike
         t=0.35  right mid-stance, left toe-off
         t=0.70  left heel strike
         t=1.05  left mid-stance, right toe-off
         ================================================================ -->
    <action name="Walk" duration="1.4" loop="true">

      <!-- Body bob: peaks at mid-stance of each foot (twice per cycle) -->
      <channel target="Root" property="position.y">
        <keyframe time="0.00" value="0.000" interp="cubic">
          <handle_right dt="0.18" dv="0.014"/>
        </keyframe>
        <keyframe time="0.25" value="0.020" interp="cubic">
          <handle_left  dt="-0.14" dv="0.014"/>
          <handle_right dt="0.14"  dv="-0.014"/>
        </keyframe>
        <keyframe time="0.50" value="0.000" interp="cubic">
          <handle_left  dt="-0.14" dv="-0.014"/>
          <handle_right dt="0.14"  dv="0.014"/>
        </keyframe>
        <keyframe time="0.75" value="0.020" interp="cubic">
          <handle_left  dt="-0.14" dv="0.014"/>
          <handle_right dt="0.14"  dv="-0.014"/>
        </keyframe>
        <keyframe time="1.00" value="0.000" interp="cubic">
          <handle_left  dt="-0.14" dv="-0.014"/>
          <handle_right dt="0.18"  dv="0.010"/>
        </keyframe>
        <keyframe time="1.40" value="0.000" interp="cubic">
          <handle_left  dt="-0.18" dv="-0.010"/>
        </keyframe>
      </channel>

      <!-- Pelvis lateral sway: leans over the stance leg -->
      <channel target="Pelvis" property="rotation.z">
        <keyframe time="0.00" value=" 4.0" interp="cubic">
          <handle_right dt="0.25" dv="-1.5"/>
        </keyframe>
        <keyframe time="0.35" value=" 5.5" interp="cubic">
          <handle_left  dt="-0.20" dv="-1.5"/>
          <handle_right dt="0.20"  dv="-8.0"/>
        </keyframe>
        <keyframe time="0.70" value="-4.0" interp="cubic">
          <handle_left  dt="-0.20" dv="-8.0"/>
          <handle_right dt="0.25"  dv=" 1.5"/>
        </keyframe>
        <keyframe time="1.05" value="-5.5" interp="cubic">
          <handle_left  dt="-0.20" dv=" 1.5"/>
          <handle_right dt="0.20"  dv=" 8.0"/>
        </keyframe>
        <keyframe time="1.40" value=" 4.0" interp="cubic">
          <handle_left  dt="-0.20" dv=" 8.0"/>
        </keyframe>
      </channel>

      <!-- Trunk forward lean + small oscillation -->
      <channel target="Spine" property="rotation.x">
        <keyframe time="0.00" value="5.0" interp="cubic">
          <handle_right dt="0.30" dv="0.5"/>
        </keyframe>
        <keyframe time="0.35" value="6.0" interp="cubic">
          <handle_left  dt="-0.30" dv="0.5"/>
          <handle_right dt="0.30"  dv="-0.5"/>
        </keyframe>
        <keyframe time="0.70" value="5.0" interp="cubic">
          <handle_left  dt="-0.30" dv="-0.5"/>
          <handle_right dt="0.30"  dv="0.5"/>
        </keyframe>
        <keyframe time="1.05" value="6.0" interp="cubic">
          <handle_left  dt="-0.30" dv="0.5"/>
          <handle_right dt="0.30"  dv="-0.5"/>
        </keyframe>
        <keyframe time="1.40" value="5.0" interp="cubic">
          <handle_left  dt="-0.30" dv="-0.5"/>
        </keyframe>
      </channel>
      <!-- Trunk counter-rotation: opposite to lead leg -->
      <channel target="Spine" property="rotation.y">
        <keyframe time="0.00" value="-4.0" interp="cubic">
          <handle_right dt="0.30" dv="5.5"/>
        </keyframe>
        <keyframe time="0.70" value=" 4.0" interp="cubic">
          <handle_left  dt="-0.30" dv="5.5"/>
          <handle_right dt="0.30"  dv="-5.5"/>
        </keyframe>
        <keyframe time="1.40" value="-4.0" interp="cubic">
          <handle_left  dt="-0.30" dv="-5.5"/>
        </keyframe>
      </channel>

      <!-- LEFT HIP: behind at t=0, swings to front peak at t=0.50 -->
      <channel target="LHipJoint" property="rotation.x">
        <keyframe time="0.00" value="-18.0" interp="cubic">
          <handle_right dt="0.28" dv="18.0"/>
        </keyframe>
        <keyframe time="0.50" value=" 20.0" interp="cubic">
          <handle_left  dt="-0.28" dv="18.0"/>
          <handle_right dt="0.18"  dv="-8.0"/>
        </keyframe>
        <keyframe time="0.70" value=" 14.0" interp="cubic">
          <handle_left  dt="-0.15" dv="-8.0"/>
          <handle_right dt="0.25"  dv="-18.0"/>
        </keyframe>
        <keyframe time="1.05" value=" -5.0" interp="cubic">
          <handle_left  dt="-0.22" dv="-12.0"/>
          <handle_right dt="0.22"  dv="5.0"/>
        </keyframe>
        <keyframe time="1.40" value="-18.0" interp="cubic">
          <handle_left  dt="-0.28" dv="-8.0"/>
        </keyframe>
      </channel>

      <!-- LEFT KNEE: bends to clear ground during swing (t=0 to 0.7) -->
      <channel target="LKneeJoint" property="rotation.x">
        <keyframe time="0.00" value="-14.0" interp="cubic">
          <handle_right dt="0.18" dv="-28.0"/>
        </keyframe>
        <keyframe time="0.25" value="-55.0" interp="cubic">
          <handle_left  dt="-0.14" dv="-28.0"/>
          <handle_right dt="0.14"  dv="28.0"/>
        </keyframe>
        <keyframe time="0.55" value=" -4.0" interp="cubic">
          <handle_left  dt="-0.14" dv="28.0"/>
          <handle_right dt="0.12"  dv="-3.0"/>
        </keyframe>
        <keyframe time="0.70" value=" -8.0" interp="cubic">
          <handle_left  dt="-0.12" dv="-3.0"/>
          <handle_right dt="0.22"  dv="0.0"/>
        </keyframe>
        <keyframe time="1.05" value="-12.0" interp="cubic">
          <handle_left  dt="-0.20" dv="-5.0"/>
          <handle_right dt="0.20"  dv="3.0"/>
        </keyframe>
        <keyframe time="1.40" value="-14.0" interp="cubic">
          <handle_left  dt="-0.20" dv="-2.0"/>
        </keyframe>
      </channel>

      <!-- LEFT ANKLE: push-off plantar flex → swing dorsiflexion → heel strike -->
      <channel target="LAnkleJoint" property="rotation.x">
        <keyframe time="0.00" value="-22.0" interp="cubic">
          <handle_right dt="0.22" dv="20.0"/>
        </keyframe>
        <keyframe time="0.30" value="  8.0" interp="cubic">
          <handle_left  dt="-0.18" dv="15.0"/>
          <handle_right dt="0.18"  dv="-5.0"/>
        </keyframe>
        <keyframe time="0.70" value=" 16.0" interp="cubic">
          <handle_left  dt="-0.18" dv="3.0"/>
          <handle_right dt="0.18"  dv="-12.0"/>
        </keyframe>
        <keyframe time="0.90" value="  0.0" interp="cubic">
          <handle_left  dt="-0.12" dv="-8.0"/>
          <handle_right dt="0.20"  dv="-12.0"/>
        </keyframe>
        <keyframe time="1.20" value=" -5.0" interp="cubic">
          <handle_left  dt="-0.18" dv="-8.0"/>
          <handle_right dt="0.14"  dv="8.0"/>
        </keyframe>
        <keyframe time="1.40" value="-22.0" interp="cubic">
          <handle_left  dt="-0.14" dv="-18.0"/>
        </keyframe>
      </channel>

      <!-- RIGHT HIP: opposite phase (forward at t=0, goes behind) -->
      <channel target="RHipJoint" property="rotation.x">
        <keyframe time="0.00" value=" 14.0" interp="cubic">
          <handle_right dt="0.25" dv="-18.0"/>
        </keyframe>
        <keyframe time="0.35" value=" -5.0" interp="cubic">
          <handle_left  dt="-0.22" dv="-12.0"/>
          <handle_right dt="0.22"  dv="-8.0"/>
        </keyframe>
        <keyframe time="0.70" value="-18.0" interp="cubic">
          <handle_left  dt="-0.28" dv="-8.0"/>
          <handle_right dt="0.28"  dv="18.0"/>
        </keyframe>
        <keyframe time="1.20" value=" 20.0" interp="cubic">
          <handle_left  dt="-0.28" dv="18.0"/>
          <handle_right dt="0.18"  dv="-8.0"/>
        </keyframe>
        <keyframe time="1.40" value=" 14.0" interp="cubic">
          <handle_left  dt="-0.15" dv="-8.0"/>
        </keyframe>
      </channel>

      <!-- RIGHT KNEE -->
      <channel target="RKneeJoint" property="rotation.x">
        <keyframe time="0.00" value=" -8.0" interp="cubic">
          <handle_right dt="0.20" dv="-4.0"/>
        </keyframe>
        <keyframe time="0.35" value="-12.0" interp="cubic">
          <handle_left  dt="-0.20" dv="-4.0"/>
          <handle_right dt="0.18"  dv="3.0"/>
        </keyframe>
        <keyframe time="0.70" value="-14.0" interp="cubic">
          <handle_left  dt="-0.18" dv="-3.0"/>
          <handle_right dt="0.18"  dv="-28.0"/>
        </keyframe>
        <keyframe time="0.95" value="-55.0" interp="cubic">
          <handle_left  dt="-0.14" dv="-28.0"/>
          <handle_right dt="0.14"  dv="28.0"/>
        </keyframe>
        <keyframe time="1.25" value=" -4.0" interp="cubic">
          <handle_left  dt="-0.14" dv="28.0"/>
          <handle_right dt="0.12"  dv="-3.0"/>
        </keyframe>
        <keyframe time="1.40" value=" -8.0" interp="cubic">
          <handle_left  dt="-0.12" dv="-3.0"/>
        </keyframe>
      </channel>

      <!-- RIGHT ANKLE -->
      <channel target="RAnkleJoint" property="rotation.x">
        <keyframe time="0.00" value=" 16.0" interp="cubic">
          <handle_right dt="0.18" dv="-12.0"/>
        </keyframe>
        <keyframe time="0.20" value="  0.0" interp="cubic">
          <handle_left  dt="-0.12" dv="-8.0"/>
          <handle_right dt="0.20"  dv="-10.0"/>
        </keyframe>
        <keyframe time="0.50" value=" -5.0" interp="cubic">
          <handle_left  dt="-0.18" dv="-8.0"/>
          <handle_right dt="0.14"  dv="8.0"/>
        </keyframe>
        <keyframe time="0.70" value="-22.0" interp="cubic">
          <handle_left  dt="-0.14" dv="-18.0"/>
          <handle_right dt="0.22"  dv="20.0"/>
        </keyframe>
        <keyframe time="1.00" value="  8.0" interp="cubic">
          <handle_left  dt="-0.18" dv="15.0"/>
          <handle_right dt="0.18"  dv="-5.0"/>
        </keyframe>
        <keyframe time="1.40" value=" 16.0" interp="cubic">
          <handle_left  dt="-0.18" dv="3.0"/>
        </keyframe>
      </channel>

      <!-- LEFT SHOULDER: swings counter to left leg -->
      <channel target="LShoulderJoint" property="rotation.x">
        <keyframe time="0.00" value=" 22.0" interp="cubic">
          <handle_right dt="0.30" dv="-20.0"/>
        </keyframe>
        <keyframe time="0.35" value="  0.0" interp="cubic">
          <handle_left  dt="-0.30" dv="-20.0"/>
          <handle_right dt="0.30"  dv="-20.0"/>
        </keyframe>
        <keyframe time="0.70" value="-22.0" interp="cubic">
          <handle_left  dt="-0.30" dv="-20.0"/>
          <handle_right dt="0.30"  dv="20.0"/>
        </keyframe>
        <keyframe time="1.05" value="  0.0" interp="cubic">
          <handle_left  dt="-0.30" dv="20.0"/>
          <handle_right dt="0.30"  dv="20.0"/>
        </keyframe>
        <keyframe time="1.40" value=" 22.0" interp="cubic">
          <handle_left  dt="-0.30" dv="20.0"/>
        </keyframe>
      </channel>

      <!-- RIGHT SHOULDER: opposite to left -->
      <channel target="RShoulderJoint" property="rotation.x">
        <keyframe time="0.00" value="-22.0" interp="cubic">
          <handle_right dt="0.30" dv="20.0"/>
        </keyframe>
        <keyframe time="0.35" value="  0.0" interp="cubic">
          <handle_left  dt="-0.30" dv="20.0"/>
          <handle_right dt="0.30"  dv="20.0"/>
        </keyframe>
        <keyframe time="0.70" value=" 22.0" interp="cubic">
          <handle_left  dt="-0.30" dv="20.0"/>
          <handle_right dt="0.30"  dv="-20.0"/>
        </keyframe>
        <keyframe time="1.05" value="  0.0" interp="cubic">
          <handle_left  dt="-0.30" dv="-20.0"/>
          <handle_right dt="0.30"  dv="-20.0"/>
        </keyframe>
        <keyframe time="1.40" value="-22.0" interp="cubic">
          <handle_left  dt="-0.30" dv="-20.0"/>
        </keyframe>
      </channel>

      <!-- Elbow natural bend oscillates with arm swing -->
      <channel target="LElbowJoint" property="rotation.x">
        <keyframe time="0.00" value="-15.0" interp="cubic">
          <handle_right dt="0.30" dv="-8.0"/>
        </keyframe>
        <keyframe time="0.35" value="-25.0" interp="cubic">
          <handle_left  dt="-0.30" dv="-8.0"/>
          <handle_right dt="0.30"  dv="8.0"/>
        </keyframe>
        <keyframe time="0.70" value="-15.0" interp="cubic">
          <handle_left  dt="-0.30" dv="8.0"/>
          <handle_right dt="0.30"  dv="-8.0"/>
        </keyframe>
        <keyframe time="1.05" value="-25.0" interp="cubic">
          <handle_left  dt="-0.30" dv="-8.0"/>
          <handle_right dt="0.30"  dv="8.0"/>
        </keyframe>
        <keyframe time="1.40" value="-15.0" interp="cubic">
          <handle_left  dt="-0.30" dv="8.0"/>
        </keyframe>
      </channel>
      <channel target="RElbowJoint" property="rotation.x">
        <keyframe time="0.00" value="-25.0" interp="cubic">
          <handle_right dt="0.30" dv="8.0"/>
        </keyframe>
        <keyframe time="0.35" value="-15.0" interp="cubic">
          <handle_left  dt="-0.30" dv="8.0"/>
          <handle_right dt="0.30"  dv="-8.0"/>
        </keyframe>
        <keyframe time="0.70" value="-25.0" interp="cubic">
          <handle_left  dt="-0.30" dv="-8.0"/>
          <handle_right dt="0.30"  dv="8.0"/>
        </keyframe>
        <keyframe time="1.05" value="-15.0" interp="cubic">
          <handle_left  dt="-0.30" dv="8.0"/>
          <handle_right dt="0.30"  dv="-8.0"/>
        </keyframe>
        <keyframe time="1.40" value="-25.0" interp="cubic">
          <handle_left  dt="-0.30" dv="-8.0"/>
        </keyframe>
      </channel>

    </action>

    <!-- ================================================================
         JUMP — 2.0 s, no loop
         0.00-0.30  crouch
         0.30-0.50  explosive extend, leave ground
         0.50-0.90  rising
         0.90-1.10  peak
         1.10-1.40  descending
         1.40-1.55  landing impact
         1.55-2.00  recovery
         ================================================================ -->
    <action name="Jump" duration="2.0" loop="false">

      <!-- Root height arc -->
      <channel target="Root" property="position.y">
        <keyframe time="0.00" value=" 0.000" interp="cubic">
          <handle_right dt="0.20" dv="-0.30"/>
        </keyframe>
        <keyframe time="0.30" value="-0.150" interp="cubic">
          <handle_left  dt="-0.15" dv="-0.30"/>
          <handle_right dt="0.10"  dv="0.70"/>
        </keyframe>
        <keyframe time="0.50" value=" 0.000" interp="cubic">
          <handle_left  dt="-0.10" dv="0.70"/>
          <handle_right dt="0.22"  dv="1.30"/>
        </keyframe>
        <keyframe time="0.90" value=" 0.450" interp="cubic">
          <handle_left  dt="-0.22" dv="1.30"/>
          <handle_right dt="0.22"  dv="-1.30"/>
        </keyframe>
        <keyframe time="1.35" value=" 0.000" interp="cubic">
          <handle_left  dt="-0.22" dv="-1.30"/>
          <handle_right dt="0.10"  dv="-0.30"/>
        </keyframe>
        <keyframe time="1.50" value="-0.060" interp="cubic">
          <handle_left  dt="-0.10" dv="-0.20"/>
          <handle_right dt="0.25"  dv="0.18"/>
        </keyframe>
        <keyframe time="2.00" value=" 0.000" interp="cubic">
          <handle_left  dt="-0.25" dv="0.15"/>
        </keyframe>
      </channel>

      <!-- Trunk lean -->
      <channel target="Spine" property="rotation.x">
        <keyframe time="0.00" value=" 3.0" interp="cubic">
          <handle_right dt="0.20" dv="5.0"/>
        </keyframe>
        <keyframe time="0.30" value="12.0" interp="cubic">
          <handle_left  dt="-0.15" dv="5.0"/>
          <handle_right dt="0.10"  dv="-14.0"/>
        </keyframe>
        <keyframe time="0.50" value=" 1.0" interp="cubic">
          <handle_left  dt="-0.10" dv="-12.0"/>
          <handle_right dt="0.22"  dv="-3.0"/>
        </keyframe>
        <keyframe time="0.90" value="-2.0" interp="cubic">
          <handle_left  dt="-0.22" dv="-3.0"/>
          <handle_right dt="0.22"  dv="6.0"/>
        </keyframe>
        <keyframe time="1.50" value="10.0" interp="cubic">
          <handle_left  dt="-0.22" dv="6.0"/>
          <handle_right dt="0.30"  dv="-8.0"/>
        </keyframe>
        <keyframe time="2.00" value=" 3.0" interp="cubic">
          <handle_left  dt="-0.25" dv="-5.0"/>
        </keyframe>
      </channel>

      <!-- Left knee: deep crouch → full extend → landing flex → recover -->
      <channel target="LKneeJoint" property="rotation.x">
        <keyframe time="0.00" value="  0.0" interp="cubic">
          <handle_right dt="0.20" dv="-65.0"/>
        </keyframe>
        <keyframe time="0.30" value="-70.0" interp="cubic">
          <handle_left  dt="-0.15" dv="-65.0"/>
          <handle_right dt="0.10"  dv="85.0"/>
        </keyframe>
        <keyframe time="0.50" value="  0.0" interp="cubic">
          <handle_left  dt="-0.10" dv="85.0"/>
          <handle_right dt="0.22"  dv="-8.0"/>
        </keyframe>
        <keyframe time="0.90" value="-10.0" interp="cubic">
          <handle_left  dt="-0.22" dv="-8.0"/>
          <handle_right dt="0.22"  dv="5.0"/>
        </keyframe>
        <keyframe time="1.35" value="  0.0" interp="cubic">
          <handle_left  dt="-0.22" dv="5.0"/>
          <handle_right dt="0.10"  dv="-65.0"/>
        </keyframe>
        <keyframe time="1.50" value="-60.0" interp="cubic">
          <handle_left  dt="-0.10" dv="-65.0"/>
          <handle_right dt="0.30"  dv="65.0"/>
        </keyframe>
        <keyframe time="2.00" value="  0.0" interp="cubic">
          <handle_left  dt="-0.25" dv="50.0"/>
        </keyframe>
      </channel>

      <!-- Right knee: symmetric -->
      <channel target="RKneeJoint" property="rotation.x">
        <keyframe time="0.00" value="  0.0" interp="cubic">
          <handle_right dt="0.20" dv="-65.0"/>
        </keyframe>
        <keyframe time="0.30" value="-70.0" interp="cubic">
          <handle_left  dt="-0.15" dv="-65.0"/>
          <handle_right dt="0.10"  dv="85.0"/>
        </keyframe>
        <keyframe time="0.50" value="  0.0" interp="cubic">
          <handle_left  dt="-0.10" dv="85.0"/>
          <handle_right dt="0.22"  dv="-8.0"/>
        </keyframe>
        <keyframe time="0.90" value="-10.0" interp="cubic">
          <handle_left  dt="-0.22" dv="-8.0"/>
          <handle_right dt="0.22"  dv="5.0"/>
        </keyframe>
        <keyframe time="1.35" value="  0.0" interp="cubic">
          <handle_left  dt="-0.22" dv="5.0"/>
          <handle_right dt="0.10"  dv="-65.0"/>
        </keyframe>
        <keyframe time="1.50" value="-60.0" interp="cubic">
          <handle_left  dt="-0.10" dv="-65.0"/>
          <handle_right dt="0.30"  dv="65.0"/>
        </keyframe>
        <keyframe time="2.00" value="  0.0" interp="cubic">
          <handle_left  dt="-0.25" dv="50.0"/>
        </keyframe>
      </channel>

      <!-- Left ankle: dorsiflexion in crouch → plantar flex at push-off → heel-ready landing -->
      <channel target="LAnkleJoint" property="rotation.x">
        <keyframe time="0.00" value="  0.0" interp="cubic">
          <handle_right dt="0.20" dv="12.0"/>
        </keyframe>
