              <sphere   name="LIdxTip"   radius="0.013" segments="6"               position="-0.026 -0.158  0" material="skin"/>
              <cylinder name="LMid1"     radius="0.013" height="0.055" segments="8" position="-0.008 -0.133  0" material="skin"/>
              <sphere   name="LMidTip"   radius="0.014" segments="6"               position="-0.008 -0.163  0" material="skin"/>
              <cylinder name="LRng1"     radius="0.012" height="0.050" segments="8" position=" 0.010 -0.130  0" material="skin"/>
              <sphere   name="LRngTip"   radius="0.013" segments="6"               position=" 0.010 -0.158  0" material="skin"/>
              <cylinder name="LPnk1"     radius="0.010" height="0.038" segments="8" position=" 0.026 -0.123  0" material="skin"/>
              <sphere   name="LPnkTip"   radius="0.011" segments="6"               position=" 0.026 -0.146  0" material="skin"/>
              <cylinder name="LThumb1"   radius="0.014" height="0.040" segments="8" position="-0.040 -0.080 -0.010" rotation="0 0 40" material="skin"/>
              <sphere   name="LThumbTip" radius="0.015" segments="6"               position="-0.062 -0.062 -0.010"                   material="skin"/>
            </group>
          </group>
        </group>

        <!-- ============================================================
             RIGHT ARM (mirror of left, no watch)
             ============================================================ -->
        <group name="RShoulderJoint" position="0.185 0.575 0">
          <sphere   name="RShoulderSph" radius="0.068" segments="12" position="0 0 0"          material="shirt"/>
          <cylinder name="RUpperArm"    radius="0.046" height="0.275" segments="16" position="0 -0.138 0" material="shirt"/>

          <group name="RElbowJoint" position="0 -0.275 0">
            <sphere   name="RElbowSph" radius="0.036" segments="10" position="0 0 0"          material="shirt"/>
            <cylinder name="RCuff"     radius="0.040" height="0.030" segments="16" position="0 -0.008 0" material="shirt"/>
            <cylinder name="RForearm"  radius="0.036" height="0.255" segments="16" position="0 -0.128 0" material="skin"/>

            <group name="RWristJoint" position="0 -0.255 0">
              <sphere name="RWristSph" radius="0.028" segments="8" position="0 0 0" material="skin"/>
              <box name="RPalm" size="0.082 0.105 0.028" position="0 -0.058 0" material="skin"/>
              <cylinder name="RIdx1"     radius="0.012" height="0.050" segments="8" position=" 0.026 -0.130  0" material="skin"/>
              <sphere   name="RIdxTip"   radius="0.013" segments="6"               position=" 0.026 -0.158  0" material="skin"/>
              <cylinder name="RMid1"     radius="0.013" height="0.055" segments="8" position=" 0.008 -0.133  0" material="skin"/>
              <sphere   name="RMidTip"   radius="0.014" segments="6"               position=" 0.008 -0.163  0" material="skin"/>
              <cylinder name="RRng1"     radius="0.012" height="0.050" segments="8" position="-0.010 -0.130  0" material="skin"/>
              <sphere   name="RRngTip"   radius="0.013" segments="6"               position="-0.010 -0.158  0" material="skin"/>
              <cylinder name="RPnk1"     radius="0.010" height="0.038" segments="8" position="-0.026 -0.123  0" material="skin"/>
              <sphere   name="RPnkTip"   radius="0.011" segments="6"               position="-0.026 -0.146  0" material="skin"/>
              <cylinder name="RThumb1"   radius="0.014" height="0.040" segments="8" position=" 0.040 -0.080 -0.010" rotation="0 0 -40" material="skin"/>
              <sphere   name="RThumbTip" radius="0.015" segments="6"               position=" 0.062 -0.062 -0.010"                    material="skin"/>
            </group>
          </group>
        </group>

        <!-- ============================================================
             NECK + HEAD
             NeckJoint local in Spine: (0 0.600 0)  world Y=1.440
             HeadJoint local in NeckJoint: (0 0.115 0)  world Y=1.555
             Skull centre world Y=1.575, top Y=1.685
             ============================================================ -->
        <group name="NeckJoint" position="0 0.600 0">
          <cylinder name="Neck"       radius="0.042" height="0.115" segments="12" position="0 0.058  0"     material="skin"/>
          <sphere   name="AdamsApple" radius="0.016" segments="8"                 position="0 0.068 -0.040" material="skin"/>

          <group name="HeadJoint" position="0 0.115 0">

            <!-- Head shape: skull + jaw + chin via CSG union -->
            <union name="HeadUnion" position="0 0.020 0" material="skin">
              <sphere name="Skull" radius="0.110" segments="20"                          material="skin"/>
              <sphere name="Jaw"   radius="0.088" segments="16" position="0 -0.040  0.018" material="skin"/>
              <sphere name="Chin"  radius="0.052" segments="12" position="0 -0.090  0.018" material="skin"/>
            </union>

            <!-- Hair -->
            <sphere name="HairMain"   radius="0.105" segments="16" position="0       0.085  0"     material="hair"/>
            <sphere name="HairFrontL" radius="0.062" segments="12" position="-0.055  0.095 -0.060" material="hair"/>
            <sphere name="HairFrontR" radius="0.062" segments="12" position=" 0.055  0.095 -0.060" material="hair"/>
            <sphere name="HairBack"   radius="0.072" segments="12" position="0       0.060  0.065" material="hair"/>
            <sphere name="HairSideL"  radius="0.050" segments="10" position="-0.095  0.045  0.010" material="hair"/>
            <sphere name="HairSideR"  radius="0.050" segments="10" position=" 0.095  0.045  0.010" material="hair"/>

            <!-- Ears -->
            <sphere name="EarL"     radius="0.030" segments="10" position="-0.108  0.012  0"     material="skin"/>
            <sphere name="EarLLobe" radius="0.018" segments="8"  position="-0.108 -0.018  0.005" material="skin"/>
            <sphere name="EarR"     radius="0.030" segments="10" position=" 0.108  0.012  0"     material="skin"/>
            <sphere name="EarRLobe" radius="0.018" segments="8"  position=" 0.108 -0.018  0.005" material="skin"/>

            <!-- Cheeks -->
            <sphere name="CheekL" radius="0.048" segments="10" position="-0.068 -0.012 -0.068" material="skin"/>
            <sphere name="CheekR" radius="0.048" segments="10" position=" 0.068 -0.012 -0.068" material="skin"/>

            <!-- LEFT EYE group -->
            <group name="LEyeGroup" position="-0.038 0.022 -0.095">
              <sphere name="LEyeWhite" radius="0.025" segments="12" position="0 0  0"       material="eye_white"/>
              <sphere name="LEyeIris"  radius="0.016" segments="10" position="0 0 -0.014"   material="eye_iris"/>
              <sphere name="LEyePupil" radius="0.009" segments="8"  position="0 0 -0.020"   material="pupil"/>
              <sphere name="LEyeCatch" radius="0.004" segments="6"  position="-0.006 0.006 -0.024" material="catchlight"/>
              <box name="LEyelidTop" size="0.055 0.010 0.026" position="0  0.010 -0.010" rotation="-15 0 0" material="skin"/>
              <box name="LEyelidBot" size="0.050 0.008 0.020" position="0 -0.010 -0.008" rotation="  8 0 0" material="skin"/>
            </group>

            <!-- RIGHT EYE group -->
            <group name="REyeGroup" position="0.038 0.022 -0.095">
              <sphere name="REyeWhite" radius="0.025" segments="12" position="0 0  0"       material="eye_white"/>
              <sphere name="REyeIris"  radius="0.016" segments="10" position="0 0 -0.014"   material="eye_iris"/>
              <sphere name="REyePupil" radius="0.009" segments="8"  position="0 0 -0.020"   material="pupil"/>
              <sphere name="REyeCatch" radius="0.004" segments="6"  position="0.006 0.006 -0.024" material="catchlight"/>
              <box name="REyelidTop" size="0.055 0.010 0.026" position="0  0.010 -0.010" rotation="-15 0 0" material="skin"/>
              <box name="REyelidBot" size="0.050 0.008 0.020" position="0 -0.010 -0.008" rotation="  8 0 0" material="skin"/>
            </group>

            <!-- Eyebrows -->
            <box name="LEyebrow" size="0.052 0.010 0.014" position="-0.038 0.048 -0.096" rotation="0 0 -8" material="eyebrow"/>
            <box name="REyebrow" size="0.052 0.010 0.014" position=" 0.038 0.048 -0.096" rotation="0 0  8" material="eyebrow"/>

            <!-- Nose -->
            <box    name="NoseBridge" size="0.022 0.048 0.020" position="0  0.005 -0.108"          material="skin"/>
            <sphere name="NoseTip"    radius="0.022" segments="10"   position="0 -0.022 -0.118"    material="skin"/>
            <sphere name="NoseWingL"  radius="0.014" segments="8"    position="-0.020 -0.026 -0.112" material="skin"/>
            <sphere name="NoseWingR"  radius="0.014" segments="8"    position=" 0.020 -0.026 -0.112" material="skin"/>

            <!-- Lips -->
            <box    name="UpperLip"   size="0.060 0.016 0.020" position="0 -0.052 -0.105" rotation="10 0 0"  material="lips"/>
