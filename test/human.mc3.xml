<?xml version="1.0" encoding="UTF-8"?>
<mc3 version="0.3" model="Human">

  <environment>
    <background color="0.12 0.14 0.18"/>
    <fog color="0.12 0.14 0.18" density="0.015"/>
  </environment>

  <lights>
    <ambient color="0.35 0.35 0.40" brightness="0.6"/>
    <!-- Key light: warm, upper-left-front -->
    <directional name="KeyLight"  color="1.0 0.95 0.85" brightness="2.2" direction="-0.5 -1.0 -0.7"/>
    <!-- Fill light: cool, right side -->
    <point       name="FillLight" color="0.70 0.80 1.0"  brightness="0.8" position="2.5 1.2 1.0"/>
    <!-- Rim light: back -->
    <directional name="RimLight"  color="0.90 0.95 1.0"  brightness="1.1" direction="0.3 -0.5 1.0"/>
  </lights>

  <cameras>
    <camera name="FullBody" position="0 0.9 3.2"  target="0 0.9 0"   fov="45"/>
    <camera name="Face"     position="0 1.58 1.1"  target="0 1.58 0"  fov="35"/>
    <camera name="Action"   position="1.5 1.2 2.5" target="0 0.85 0"  fov="55"/>
  </cameras>

  <textures>
    <texture id="skin_diffuse"  uri="textures/skin_diffuse.png"  color_space="srgb"   filter="linear" wrap_u="repeat" wrap_v="repeat"/>
    <texture id="skin_rough"    uri="textures/skin_roughness.png" color_space="linear" filter="linear" wrap_u="repeat" wrap_v="repeat"/>
    <texture id="hair_diffuse"  uri="textures/hair_diffuse.png"  color_space="srgb"   filter="linear" wrap_u="repeat" wrap_v="repeat"/>
  </textures>

