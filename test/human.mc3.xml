      <base_color>1.0 1.0 1.0 1.0</base_color>
      <base_color_texture>skin_diffuse</base_color_texture>
      <!-- ORM texture: R=occlusion, G=roughness, B=metallic -->
      <metallic_roughness_texture>skin_rough</metallic_roughness_texture>
    </material>
    <material id="hair" roughness="0.85" metallic="0.0">
      <base_color>1.0 1.0 1.0 1.0</base_color>
      <base_color_texture>hair_diffuse</base_color_texture>
    </material>
    <material id="shirt" roughness="0.80" metallic="0.0">
      <base_color>0.22 0.40 0.72 1.0</base_color>
    </material>
    <material id="pants" roughness="0.78" metallic="0.0">
      <base_color>0.15 0.18 0.30 1.0</base_color>
    </material>
    <material id="shoes" roughness="0.55" metallic="0.0">
      <base_color>0.14 0.09 0.06 1.0</base_color>
    </material>
    <material id="sole" roughness="0.92" metallic="0.0">
      <base_color>0.07 0.07 0.07 1.0</base_color>
    </material>
    <material id="belt" roughness="0.50" metallic="0.0">
      <base_color>0.20 0.13 0.08 1.0</base_color>
    </material>
    <material id="buckle" roughness="0.25" metallic="0.90">
      <base_color>0.72 0.65 0.35 1.0</base_color>
    </material>
