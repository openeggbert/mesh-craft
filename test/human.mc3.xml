          <cylinder name="HipCyl"  radius="0.128" height="0.180" segments="16" material="pants"/>
          <sphere   name="HipSphL" radius="0.106" segments="14" position="-0.092 0.0 0" material="pants"/>
          <sphere   name="HipSphR" radius="0.106" segments="14" position=" 0.092 0.0 0" material="pants"/>
        </union>

        <!-- Belt sits at hip centre -->
        <cylinder name="Belt"   radius="0.132" height="0.034" segments="16" position="0 0.010 0"     material="belt"/>
        <box      name="Buckle" size="0.044 0.030 0.010"                     position="0 0.010 -0.132" material="buckle"/>

        <!-- ============================================================
             LEFT LEG  (local X = -0.100 from pelvis pivot)
             Thigh 0.370 m  knee world Y = 0.470
             Calf  0.378 m  ankle world Y = 0.092
             Sole bottom world Y = 0.000
             ============================================================ -->
        <group name="LHipJoint" position="-0.100 0 0">
          <sphere   name="LHipSph" radius="0.070" segments="12" position="0 0 0"          material="pants"/>
          <cylinder name="LThigh"  radius="0.066" height="0.370" segments="16" position="0 -0.185 0" material="pants"/>

