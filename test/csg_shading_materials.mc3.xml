<?xml version="1.0" encoding="UTF-8"?>
<!-- SYS-W14-06: source-material runs, smooth normal output, and a root UV
     projection for a real Manifold CSG result. The CSG root deliberately has
     no material: red/blue must survive as separate glTF primitives. -->
<mc3 version="0.3" model="CsgShadingMaterials">
  <materials>
    <material id="red"><base_color>0.9 0.1 0.1 1.0</base_color></material>
    <material id="blue"><base_color>0.1 0.2 0.9 1.0</base_color></material>
  </materials>
  <objects>
    <union name="ChildMaterials">
      <uv_mapping projection="planar" scale_u="2" scale_v="3" offset_u="0.25" offset_v="-0.5"/>
      <box name="RedBox" size="1.4 1.4 1.4" position="-0.35 0 0" material="red"/>
      <sphere name="BlueSphere" radius="0.82" position="0.35 0 0" material="blue"/>
    </union>
  </objects>
</mc3>
