<?xml version="1.0" encoding="UTF-8"?>
<mc3 version="0.3" model="AnimationUnsupportedTest">

  <materials>
    <material id="glow" roughness="0.5"><base_color>0.5 0.5 0.5 1.0</base_color></material>
  </materials>

  <objects>
    <box name="GlowBox" size="1 1 1" material="glow"/>
    <box name="SquashBox" size="1 1 1"/>
  </objects>

  <actions>
    <!-- Pulse: GlowBox's material color animated — no glTF node-transform equivalent -->
    <action name="Pulse" duration="1.0" loop="true">
      <channel target="GlowBox" property="material.baseColor.r">
        <keyframe time="0.0" value="0.2" interp="linear"/>
        <keyframe time="1.0" value="0.9" interp="linear"/>
      </channel>
    </action>

    <!-- Squash: SquashBox's deform animated — no glTF node-transform equivalent -->
    <action name="Squash" duration="1.0" loop="true">
      <channel target="SquashBox" property="deform.x">
        <keyframe time="0.0" value="1.0" interp="linear"/>
        <keyframe time="1.0" value="1.8" interp="linear"/>
      </channel>
    </action>

    <!-- STAB-0684: the remaining 11 of 13 AnimatedProperty values sharing
         the generic unsupported-property skip path (Pulse/Squash above
         only cover 2) — visible, deform.y/z, material.baseColor.g/b/a,
         material.roughness/metallic, material.emissive.r/g/b. -->
    <action name="RemainingUnsupported" duration="1.0" loop="true">
      <channel target="GlowBox" property="visible">
        <keyframe time="0.0" value="1.0" interp="step"/>
        <keyframe time="1.0" value="0.0" interp="step"/>
      </channel>
      <channel target="SquashBox" property="deform.y">
        <keyframe time="0.0" value="1.0" interp="linear"/>
        <keyframe time="1.0" value="1.5" interp="linear"/>
      </channel>
      <channel target="SquashBox" property="deform.z">
        <keyframe time="0.0" value="1.0" interp="linear"/>
        <keyframe time="1.0" value="1.5" interp="linear"/>
      </channel>
      <channel target="GlowBox" property="material.baseColor.g">
        <keyframe time="0.0" value="0.2" interp="linear"/>
        <keyframe time="1.0" value="0.9" interp="linear"/>
      </channel>
      <channel target="GlowBox" property="material.baseColor.b">
        <keyframe time="0.0" value="0.2" interp="linear"/>
        <keyframe time="1.0" value="0.9" interp="linear"/>
      </channel>
      <channel target="GlowBox" property="material.baseColor.a">
        <keyframe time="0.0" value="1.0" interp="linear"/>
        <keyframe time="1.0" value="0.5" interp="linear"/>
      </channel>
      <channel target="GlowBox" property="material.roughness">
        <keyframe time="0.0" value="0.2" interp="linear"/>
        <keyframe time="1.0" value="0.9" interp="linear"/>
      </channel>
      <channel target="GlowBox" property="material.metallic">
        <keyframe time="0.0" value="0.0" interp="linear"/>
        <keyframe time="1.0" value="1.0" interp="linear"/>
      </channel>
      <channel target="GlowBox" property="material.emissive.r">
        <keyframe time="0.0" value="0.0" interp="linear"/>
        <keyframe time="1.0" value="1.0" interp="linear"/>
      </channel>
      <channel target="GlowBox" property="material.emissive.g">
        <keyframe time="0.0" value="0.0" interp="linear"/>
        <keyframe time="1.0" value="1.0" interp="linear"/>
      </channel>
      <channel target="GlowBox" property="material.emissive.b">
        <keyframe time="0.0" value="0.0" interp="linear"/>
        <keyframe time="1.0" value="1.0" interp="linear"/>
      </channel>
    </action>
  </actions>

</mc3>
