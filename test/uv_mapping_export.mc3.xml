<?xml version="1.0" encoding="UTF-8"?>
<mc3 version="0.3" model="UvMappingTest">
  <objects>
    <!-- Control: no uv_mapping at all, default unit UV unwrap, U in [0,1]. -->
    <box name="PlainBox" size="1 1 1" position="0 0 0"/>

    <!-- AUD-024: scale/offset/rotation must actually transform TEXCOORD_0. -->
    <box name="ScaledUvBox" size="1 1 1" position="2 0 0">
      <uv_mapping projection="planar" scale_u="4" scale_v="1" offset_u="0.5" offset_v="0"/>
    </box>

    <!-- SYS-W14-24: box/triplanar projection. Per-vertex UVs are raw
         local-space coordinates on the two non-dominant axes (not
         normalized to [0,1] like the default planar unwrap), so a unit
         (size 1x1x1) box's projected TEXCOORD_0 spans [-0.5, 0.5]. -->
    <box name="BoxProjectedBox" size="1 1 1" position="4 0 0">
      <uv_mapping projection="box"/>
    </box>

    <!-- SYS-W14-24: spherical (equirectangular) projection around the
         mesh's local bounding-box center. Normalized to [0,1] on both
         axes regardless of object size. -->
    <box name="SphereProjectedBox" size="1 1 1" position="6 0 0">
      <uv_mapping projection="sphere"/>
    </box>
  </objects>
</mc3>
