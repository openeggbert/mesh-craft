<?xml version="1.0" encoding="UTF-8"?>
<!-- STAB-0513 fixture: a single spot light with a distinctive bright cyan
     color, positioned at the origin and aimed straight at the camera, with
     no other scene content that could plausibly render that color — so the
     gizmo's sphere+cone marker (drawLightGizmos(), Spot case, unconditional,
     no UI toggle, same draw path as STAB-0512's point-light gizmo) can be
     confirmed via pixel sampling. -->
<mc3 version="0.3" model="SpotLightGizmoFixture" default_camera="Main">

  <lights>
    <spot name="Marker" color="0.0 1.0 1.0" brightness="1.0"
          position="0 0 0" direction="0 0 1" angle="25" falloff="30" range="10"/>
  </lights>

  <cameras>
    <camera name="Main" position="0 0 3" target="0 0 0" fov="50" near="0.05" far="100"/>
  </cameras>

  <objects/>

</mc3>
