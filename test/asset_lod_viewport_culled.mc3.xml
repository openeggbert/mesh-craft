<?xml version="1.0" encoding="UTF-8"?>
<!-- SYS-W14-29 viewport coverage: the same asset is beyond its authored
     max_visibility_distance and must be absent from the normal draw pass. -->
<mc3 version="0.3" model="AssetLodViewportCulled" default_camera="Main">
  <cameras><camera name="Main" position="0 0 120" target="0 0 0" fov="50" near="0.05" far="200"/></cameras>
  <definitions>
    <definition id="tree.base"><box name="Base" size="1 1 1"><assetMetadata max_visibility_distance="100"><lods><lod tier="near" definition="tree.near"/><lod tier="far" definition="tree.far"/></lods></assetMetadata></box></definition>
    <definition id="tree.near"><sphere name="Near" radius="0.8" segments="16"/></definition>
    <definition id="tree.far"><box name="Far" size="0.3 1.2 0.3"/></definition>
  </definitions>
  <objects><instance id="asset-lod-instance" name="Asset LOD instance" definition="tree.base"/></objects>
</mc3>
