<?xml version="1.0" encoding="UTF-8"?>
<!-- S5 CSG stress fixtures.

     TenBoxUnion (STAB-0223): a union of 10 overlapping boxes. Confirms
     a wider-than-typical child count exports without crashing and
     produces real (non-zero) triangle geometry.

     DeepUnion (STAB-0233): a union tree exactly 5 levels deep containing
     32 boxes total (4 boxes at each of levels 1-4, plus 16 boxes at the
     innermost level 5). A performance test asserts this evaluates in
     under 5 seconds. -->
<mc3 version="0.3" model="CsgStress">
  <objects>

    <union name="TenBoxUnion">
      <box name="B0" size="1 1 1" position="0.0 0 0"/>
      <box name="B1" size="1 1 1" position="0.7 0 0"/>
      <box name="B2" size="1 1 1" position="1.4 0 0"/>
      <box name="B3" size="1 1 1" position="2.1 0 0"/>
      <box name="B4" size="1 1 1" position="2.8 0 0"/>
      <box name="B5" size="1 1 1" position="3.5 0 0"/>
      <box name="B6" size="1 1 1" position="4.2 0 0"/>
      <box name="B7" size="1 1 1" position="4.9 0 0"/>
      <box name="B8" size="1 1 1" position="5.6 0 0"/>
      <box name="B9" size="1 1 1" position="6.3 0 0"/>
    </union>

    <union name="DeepUnion" position="0 6 0">
      <box name="D1_a" size="1 1 1" position="0 0 0"/>
      <box name="D1_b" size="1 1 1" position="0.6 0 0"/>
      <box name="D1_c" size="1 1 1" position="1.2 0 0"/>
      <box name="D1_d" size="1 1 1" position="1.8 0 0"/>
      <union name="Level2">
        <box name="D2_a" size="1 1 1" position="2.4 0 0"/>
        <box name="D2_b" size="1 1 1" position="3.0 0 0"/>
        <box name="D2_c" size="1 1 1" position="3.6 0 0"/>
        <box name="D2_d" size="1 1 1" position="4.2 0 0"/>
        <union name="Level3">
          <box name="D3_a" size="1 1 1" position="4.8 0 0"/>
          <box name="D3_b" size="1 1 1" position="5.4 0 0"/>
          <box name="D3_c" size="1 1 1" position="6.0 0 0"/>
          <box name="D3_d" size="1 1 1" position="6.6 0 0"/>
          <union name="Level4">
            <box name="D4_a" size="1 1 1" position="7.2 0 0"/>
            <box name="D4_b" size="1 1 1" position="7.8 0 0"/>
            <box name="D4_c" size="1 1 1" position="8.4 0 0"/>
            <box name="D4_d" size="1 1 1" position="9.0 0 0"/>
            <union name="Level5">
              <box name="D5_a"  size="1 1 1" position="9.6  0 0"/>
              <box name="D5_b"  size="1 1 1" position="10.2 0 0"/>
              <box name="D5_c"  size="1 1 1" position="10.8 0 0"/>
              <box name="D5_d"  size="1 1 1" position="11.4 0 0"/>
              <box name="D5_e"  size="1 1 1" position="12.0 0 0"/>
              <box name="D5_f"  size="1 1 1" position="12.6 0 0"/>
              <box name="D5_g"  size="1 1 1" position="13.2 0 0"/>
              <box name="D5_h"  size="1 1 1" position="13.8 0 0"/>
              <box name="D5_i"  size="1 1 1" position="14.4 0 0"/>
              <box name="D5_j"  size="1 1 1" position="15.0 0 0"/>
              <box name="D5_k"  size="1 1 1" position="15.6 0 0"/>
              <box name="D5_l"  size="1 1 1" position="16.2 0 0"/>
              <box name="D5_m"  size="1 1 1" position="16.8 0 0"/>
              <box name="D5_n"  size="1 1 1" position="17.4 0 0"/>
              <box name="D5_o"  size="1 1 1" position="18.0 0 0"/>
              <box name="D5_p"  size="1 1 1" position="18.6 0 0"/>
            </union>
          </union>
        </union>
      </union>
    </union>

  </objects>
</mc3>
