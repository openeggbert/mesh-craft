<?xml version="1.0" encoding="UTF-8"?>
<mc3 version="0.2" model="CsgTest">

  <environment>
    <background color="0.3 0.3 0.4"/>
  </environment>

  <lights>
    <ambient     color="0.3 0.3 0.4" brightness="0.5"/>
    <directional name="Sun" color="1 0.95 0.8" brightness="2" direction="-0.5 -1 -0.5"/>
  </lights>

  <cameras>
    <camera name="Main" position="4 3 6" target="0 0 0" fov="60"/>
  </cameras>

  <materials>
    <material id="stone"><base_color>0.7 0.65 0.6 1.0</base_color></material>
    <material id="red"><base_color>0.9 0.1 0.1 1.0</base_color></material>
    <material id="blue"><base_color>0.1 0.3 0.9 1.0</base_color></material>
  </materials>

  <objects>
    <!-- Difference: box minus sphere (arch hole) -->
    <difference name="ArchHole" position="-2 0 0" material="stone">
      <box    name="block"  size="1.5 1.5 1.5"/>
      <sphere name="cavity" radius="0.7" role="cutter"/>
    </difference>

    <!-- Union: two overlapping spheres fused together -->
    <union name="Merged" position="2 0 0" material="blue">
      <sphere name="s1" radius="0.6" position="-0.3 0 0"/>
      <sphere name="s2" radius="0.6" position=" 0.3 0 0"/>
    </union>

    <!-- Intersection: cube AND sphere → rounded cube -->
    <intersection name="RoundedBlock" position="0 2 0" material="red">
      <box    name="b" size="1.2 1.2 1.2"/>
      <sphere name="s" radius="0.75"/>
    </intersection>
  </objects>

</mc3>
